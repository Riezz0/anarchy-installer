#!/usr/bin/env bash
set -Eeuo pipefail

# Anarchy Arch installer. Run from the Arch ISO as root.
if (( EUID != 0 )); then
    printf 'Run this installer as root.\n' >&2
    exit 1
fi
for command in gum figlet lsblk sgdisk pacstrap arch-chroot git; do
    command -v "$command" >/dev/null || { printf 'Missing command: %s\n' "$command" >&2; exit 1; }
done

BG='#1a1b26'; FG='#c0caf5'; BLUE='#7aa2f7'; CYAN='#7dcfff'
GREEN='#9ece6a'; YELLOW='#e0af68'; RED='#f7768e'; PURPLE='#bb9af7'
info() { gum style --foreground "$CYAN" "  ◆ $*"; }
step() { gum style --foreground "$BLUE" --bold "  ➜ $*"; }
ok() { gum style --foreground "$GREEN" "  ✓ $*"; }
fail() { gum style --foreground "$RED" --bold "  ✖ $*"; }
banner() { gum style --foreground "$PURPLE" --border double --border-foreground "$BLUE" --padding '0 2' --bold "$1"; }

# Always detach every mount created by this script when it exits or is interrupted.
SQUASHFS_MOUNT=''; SQUASHFS_LOOP=''; PACMAN_CONF=''; ARCH_PACMAN_CONF=''
cleanup() {
    set +e
    [[ -n "$SQUASHFS_MOUNT" ]] && umount -R "$SQUASHFS_MOUNT" &>/dev/null
    [[ -n "$SQUASHFS_LOOP" ]] && losetup -d "$SQUASHFS_LOOP" &>/dev/null
    [[ -n "$PACMAN_CONF" ]] && rm -f "$PACMAN_CONF"
    [[ -n "$ARCH_PACMAN_CONF" ]] && rm -f "$ARCH_PACMAN_CONF"
    umount -R /mnt &>/dev/null
}
trap cleanup EXIT
trap 'cleanup; exit 130' INT TERM
cleanup

banner "Anarchy Arch Linux"

IS_EFI=false; [[ -d /sys/firmware/efi ]] && IS_EFI=true
TARGET_DRIVE=$(lsblk -dpno NAME,SIZE | gum choose --header 'Select target drive' --cursor '➜ ')
[[ -n "$TARGET_DRIVE" ]] || exit 1
TARGET_DRIVE=${TARGET_DRIVE%% *}
PART_PREFIX=''; [[ "$TARGET_DRIVE" =~ [0-9]$ ]] && PART_PREFIX='p'
EFI_PART="${TARGET_DRIVE}${PART_PREFIX}1"; ROOT_PART="${TARGET_DRIVE}${PART_PREFIX}2"

ROOT_PASS=$(gum input --password --prompt 'Root password: '); [[ -n "$ROOT_PASS" ]] || exit 1
NEW_USER=$(gum input --prompt 'Username: '); [[ "$NEW_USER" =~ ^[a-z_][a-z0-9_-]*$ ]] || { fail 'Invalid username.'; exit 1; }
NEW_PASS=$(gum input --password --prompt 'User password: '); [[ -n "$NEW_PASS" ]] || exit 1
TIMEZONE=$(timedatectl list-timezones | gum filter --placeholder 'Select timezone'); TIMEZONE=${TIMEZONE:-UTC}
NEW_HOSTNAME=$(gum input --prompt 'Hostname: '); [[ -n "$NEW_HOSTNAME" ]] || exit 1

MICROCODE_PACKAGE=amd-ucode
GPU_PACKAGES=(mesa lib32-mesa vulkan-radeon lib32-vulkan-radeon)
EFI_PACKAGES=(); "$IS_EFI" && EFI_PACKAGES=(efibootmgr)

banner Summary
SUMMARY=$(printf 'User: %s\nTimezone: %s\nHostname: %s\nDrive: %s\nGPU: AMD (Mesa/Vulkan)\nMicrocode: AMD (amd-ucode)\nKernel: linux-zen (Arch mirrors)\nAudio: PipeWire\nVesktop: downloaded from AUR' \
    "$NEW_USER" "$TIMEZONE" "$NEW_HOSTNAME" "$TARGET_DRIVE")
gum style --foreground "$FG" --border rounded --padding '1 2' \
    "$SUMMARY"
gum confirm --affirmative 'Wipe drive' --negative 'Cancel' "Wipe $TARGET_DRIVE?" || exit 1

step 'Preparing local package repositories'
SQUASHFS=''
for path in /run/archiso/bootmnt/arch/x86_64/airootfs.sfs /run/archiso/bootmnt/arch/x86_64/rootfs.sfs /mnt/iso/arch/x86_64/airootfs.sfs; do
    [[ -f "$path" ]] && SQUASHFS="$path" && break
done
[[ -n "$SQUASHFS" ]] || SQUASHFS=$(gum input --prompt 'Path to airootfs.sfs: ')
[[ -f "$SQUASHFS" ]] || { fail "SquashFS not found: $SQUASHFS"; exit 1; }
SQUASHFS_MOUNT=/tmp/anarchy-installer-squashfs; mkdir -p "$SQUASHFS_MOUNT"
SQUASHFS_LOOP=$(losetup --find --show "$SQUASHFS")
mount -t squashfs -o ro "$SQUASHFS_LOOP" "$SQUASHFS_MOUNT"
LOCAL_REPO="$SQUASHFS_MOUNT/var/local/anarchy-repo"
[[ -d "$LOCAL_REPO" ]] || { fail "Missing $LOCAL_REPO in the ISO."; exit 1; }
[[ -s "$LOCAL_REPO/anarchy-repo.install" ]] || { fail "Missing install manifest in $LOCAL_REPO."; exit 1; }
[[ -s "$LOCAL_REPO/anarchy-repo.db" ]] || { fail "Missing repository database in $LOCAL_REPO."; exit 1; }
DOTFILES_BUNDLE="$SQUASHFS_MOUNT/var/local/anarchy-dots"
for required_path in \
    "$DOTFILES_BUNDLE/sys/grub/grub" \
    "$DOTFILES_BUNDLE/sys/grub/tokyo-night" \
    "$DOTFILES_BUNDLE/sys/sddm/anarchy-sddm" \
    "$DOTFILES_BUNDLE/sys/sddm/sddm.conf" \
    "$DOTFILES_BUNDLE/sys/sddm/initial-setup" \
    "$DOTFILES_BUNDLE/sys/fonts" \
    "$DOTFILES_BUNDLE/scripts/bin"; do
    [[ -e "$required_path" ]] || { fail "Missing offline desktop asset: $required_path. Rebuild the ISO."; exit 1; }
done

mapfile -t INSTALL_REPO_PACKAGES < <(grep -Ev '^(linux-zen|vesktop-bin)$' "$LOCAL_REPO/anarchy-repo.install")
(( ${#INSTALL_REPO_PACKAGES[@]} > 0 )) || { fail 'Local repository install manifest is empty.'; exit 1; }
PACMAN_CONF=$(mktemp)
awk '/^\[core\]$/ { exit } { print }' /etc/pacman.conf > "$PACMAN_CONF"
printf '\n[anarchy-repo]\nSigLevel = Optional TrustAll\nServer = file://%s\n' \
    "$LOCAL_REPO" >> "$PACMAN_CONF"
ARCH_PACMAN_CONF=$(mktemp)
sed '/^\[anarchy-repo\]/,/^$/d; /^\[anarchy-offline\]/,/^$/d' \
    /etc/pacman.conf > "$ARCH_PACMAN_CONF"

# Resolve the complete install set before partitioning. This metadata-only
# check uses the ISO repository and does not contact mirrors.
if ! pacman --config "$PACMAN_CONF" -Syy --noconfirm >/dev/null || \
   ! pacman --config "$PACMAN_CONF" -Sp --noconfirm \
    base linux-zen-headers linux-firmware btrfs-progs grub sddm \
    networkmanager hyprland uwsm pipewire pipewire-audio pipewire-alsa pipewire-pulse \
    wireplumber git stow zsh dkms base-devel sudo rsync curl "$MICROCODE_PACKAGE" \
    "${GPU_PACKAGES[@]}" "${EFI_PACKAGES[@]}" "${INSTALL_REPO_PACKAGES[@]}" >/dev/null; then
    fail 'The ISO repository is missing packages or dependencies required for this install.'
    exit 1
fi
if ! pacman --config "$ARCH_PACMAN_CONF" -Syy --noconfirm >/dev/null || \
   ! pacman --config "$ARCH_PACMAN_CONF" -Sp --noconfirm linux-zen >/dev/null; then
    fail 'Could not resolve linux-zen from the official Arch repositories; an internet connection is required.'
    exit 1
fi
if ! git ls-remote https://aur.archlinux.org/vesktop-bin.git HEAD >/dev/null 2>&1; then
    fail 'Could not reach the AUR to fetch vesktop-bin; an internet connection is required.'
    exit 1
fi

# Official repositories are used for the kernel/Vesktop online exceptions and
# retained in the installed system for future updates.
append_arch_repositories() {
    cat <<'REPOSITORIES'
[core]
Include = /etc/pacman.d/mirrorlist

[extra]
Include = /etc/pacman.d/mirrorlist

[multilib]
Include = /etc/pacman.d/mirrorlist
REPOSITORIES
}

step 'Partitioning and formatting'
sgdisk -Z "$TARGET_DRIVE"
if "$IS_EFI"; then sgdisk -n 1:0:+512M -t 1:ef00 "$TARGET_DRIVE"; else sgdisk -n 1:0:+1M -t 1:ef02 "$TARGET_DRIVE"; fi
sgdisk -n 2:0:0 -t 2:8300 "$TARGET_DRIVE"; partprobe "$TARGET_DRIVE"; sleep 2
"$IS_EFI" && mkfs.vfat -F 32 "$EFI_PART"
mkfs.btrfs -L ARCH_ROOT -f "$ROOT_PART"

step 'Creating Btrfs subvolumes'
mount "$ROOT_PART" /mnt
for subvolume in @ @home @log @pkg @.snapshots; do btrfs subvolume create "/mnt/$subvolume"; done
umount /mnt
mount -o noatime,compress=zstd,subvol=@ "$ROOT_PART" /mnt
mkdir -p /mnt/{home,var/log,var/cache/pacman/pkg,.snapshots,boot}
mount -o noatime,compress=zstd,subvol=@home "$ROOT_PART" /mnt/home
mount -o noatime,compress=zstd,subvol=@log "$ROOT_PART" /mnt/var/log
mount -o noatime,compress=zstd,subvol=@pkg "$ROOT_PART" /mnt/var/cache/pacman/pkg
mount -o noatime,compress=zstd,subvol=@.snapshots "$ROOT_PART" /mnt/.snapshots
"$IS_EFI" && mount "$EFI_PART" /mnt/boot
# Never let a cached installer archive override the version embedded in this ISO.
rm -f /mnt/var/cache/pacman/pkg/anarchy-installer-*.pkg.tar.*

step 'Installing base system and desktop packages from the ISO repository'
if ! pacstrap -C "$PACMAN_CONF" /mnt base linux-zen-headers linux-firmware btrfs-progs grub sddm \
    networkmanager hyprland uwsm pipewire pipewire-audio pipewire-alsa pipewire-pulse \
    wireplumber git stow zsh dkms base-devel sudo rsync curl "$MICROCODE_PACKAGE" \
    "${GPU_PACKAGES[@]}" "${EFI_PACKAGES[@]}"; then
    rm -f "$PACMAN_CONF"
    fail 'Failed to install the base system.'
    exit 1
fi
rm -f "$PACMAN_CONF"
PACMAN_CONF=''
[[ -x /mnt/bin/bash ]] || { fail 'Base system installation is incomplete.'; exit 1; }

step 'Downloading and installing linux-zen from Arch mirrors'
if ! pacstrap -C "$ARCH_PACMAN_CONF" /mnt linux-zen; then
    fail 'Failed to download or install linux-zen from the official Arch repositories.'
    exit 1
fi

# Seed new users from the customized live ISO and stage system-wide assets.
cp -a /etc/skel/. /mnt/etc/skel/
mkdir -p /mnt/var/local/anarchy-dots
cp -a "$DOTFILES_BUNDLE"/sys "$DOTFILES_BUNDLE"/scripts /mnt/var/local/anarchy-dots/

step 'Installing packages from anarchy-repo'
mapfile -t LOCAL_REPO_PACKAGES < <(find "$LOCAL_REPO" -maxdepth 1 -type f -name '*.pkg.tar.*' -print)
(( ${#LOCAL_REPO_PACKAGES[@]} > 0 )) || { fail 'No local repository package archives found.'; exit 1; }
(( ${#INSTALL_REPO_PACKAGES[@]} > 0 )) || { fail 'Local repository install manifest is empty.'; exit 1; }
info "Using local repository with ${#LOCAL_REPO_PACKAGES[@]} archives"
mkdir -p /mnt/var/local/anarchy-repo
mount --bind "$LOCAL_REPO" /mnt/var/local/anarchy-repo
# Keep custom repository package resolution local during this step.
awk '/^\[core\]$/ { exit } { print }' /etc/pacman.conf > /mnt/etc/pacman.conf.anarchy
printf '\n[anarchy-repo]\nSigLevel = Optional TrustAll\nServer = file:///var/local/anarchy-repo\n' \
    >> /mnt/etc/pacman.conf.anarchy
mv /mnt/etc/pacman.conf.anarchy /mnt/etc/pacman.conf
grep -Ev '^(linux-zen|vesktop-bin)$' "$LOCAL_REPO/anarchy-repo.install" > /mnt/tmp/anarchy-repo.install
PACMAN_LOG=/tmp/anarchy-pacman.log
: > "$PACMAN_LOG"
set +e
arch-chroot /mnt bash -c '
    set -Eeuo pipefail
    pacman -Syy --noconfirm
    mapfile -t packages < /tmp/anarchy-repo.install
    printf "Installing %s repository packages\\n" "${#packages[@]}"
    pacman -S --needed --noconfirm "${packages[@]}"
    rm -f /tmp/anarchy-repo.install
' 2>&1 | tee "$PACMAN_LOG"
PACMAN_STATUS=${PIPESTATUS[0]}
set -e
if (( PACMAN_STATUS != 0 )); then
    cp "$PACMAN_LOG" /mnt/root/anarchy-pacman.log 2>/dev/null || true
    fail 'Failed to install packages from anarchy-repo.'
    echo '--- Last pacman diagnostics ---' >&2
    tail -n 40 "$PACMAN_LOG" >&2
    dmesg | tail -n 30 >&2 || true
    echo '--- End pacman diagnostics ---' >&2
    exit 1
fi
umount /mnt/var/local/anarchy-repo
rmdir /mnt/var/local/anarchy-repo

step 'Configuring the installed system'
genfstab -U /mnt >> /mnt/etc/fstab
ROOT_UUID=$(blkid -s UUID -o value "$ROOT_PART")

# Restore normal online repositories for post-install use. No package commands
# are run with this config until the user boots the installed system.
awk '/^\[core\]$/ { exit } { print }' /etc/pacman.conf > /mnt/etc/pacman.conf.anarchy
append_arch_repositories >> /mnt/etc/pacman.conf.anarchy
printf '\n[anarchy-repo]\nSigLevel = Optional TrustAll\nServer = https://riezz0.github.io/\$repo/\$arch\n' \
    >> /mnt/etc/pacman.conf.anarchy
mv /mnt/etc/pacman.conf.anarchy /mnt/etc/pacman.conf
cp "$ARCH_PACMAN_CONF" /mnt/etc/pacman.conf.arch

if ! arch-chroot /mnt /bin/bash <<EOF
set -Eeuo pipefail
pacman-key --init
pacman-key --populate archlinux
rm -rf /etc/mkinitcpio.conf.d /etc/sddm.conf.d/*
userdel -f -r liveuser 2>/dev/null || true
cat > /etc/mkinitcpio.conf <<'MKINIT'
MODULES=(btrfs)
BINARIES=()
FILES=()
HOOKS=(base udev autodetect modconf kms keyboard keymap consolefont block filesystems fsck)
MKINIT
mkinitcpio -P
if $IS_EFI; then grub-install --target=x86_64-efi --efi-directory=/boot --bootloader-id=GRUB --recheck; else grub-install --target=i386-pc '$TARGET_DRIVE' --recheck; fi
useradd -m -G wheel -s /bin/bash '$NEW_USER'
echo '$NEW_USER:$NEW_PASS' | chpasswd
echo 'root:$ROOT_PASS' | chpasswd
sed -i 's/# %wheel ALL=(ALL:ALL) ALL/%wheel ALL=(ALL:ALL) ALL/' /etc/sudoers
echo '$NEW_HOSTNAME' > /etc/hostname
ln -sf '/usr/share/zoneinfo/$TIMEZONE' /etc/localtime; hwclock --systohc
cp /var/local/anarchy-dots/sys/grub/grub /etc/default/grub
cp -r /var/local/anarchy-dots/sys/grub/tokyo-night /usr/share/grub/themes/
sed -i "s|^GRUB_TOP_LEVEL=.*|GRUB_TOP_LEVEL='/boot/vmlinuz-linux-zen'|; s|^GRUB_CMDLINE_LINUX_DEFAULT=.*|GRUB_CMDLINE_LINUX_DEFAULT=\"root=UUID=$ROOT_UUID rootflags=subvol=@ rw\"|" /etc/default/grub
grub-mkconfig -o /boot/grub/grub.cfg

mkdir -p /usr/share/sddm/themes
cp -r /var/local/anarchy-dots/sys/sddm/anarchy-sddm /usr/share/sddm/themes/
cp /var/local/anarchy-dots/sys/sddm/sddm.conf /etc/sddm.conf
sed -i 's/^Session=hyprland-uswm$/Session=hyprland-uwsm.desktop/' /etc/sddm.conf
mkdir -p /var/local/sddm-wallpaper; cp -r /var/local/anarchy-dots/sys/sddm/initial-setup/. /var/local/sddm-wallpaper/
chown -R '$NEW_USER:sddm' /var/local/sddm-wallpaper; chmod -R u+rwX,g+rwX,o+rX /var/local/sddm-wallpaper

if command -v gsettings >/dev/null && command -v dbus-run-session >/dev/null && gsettings list-schemas | grep -qx com.github.stunkymonkey.nautilus-open-any-terminal; then
    su - '$NEW_USER' -c 'dbus-run-session -- gsettings set com.github.stunkymonkey.nautilus-open-any-terminal terminal kitty'
    su - '$NEW_USER' -c 'dbus-run-session -- gsettings set com.github.stunkymonkey.nautilus-open-any-terminal keybindings "<Ctrl><Alt>t"'
    su - '$NEW_USER' -c 'dbus-run-session -- gsettings set com.github.stunkymonkey.nautilus-open-any-terminal new-tab true'
fi

mkdir -p /usr/local/bin
cp -a /var/local/anarchy-dots/scripts/bin/. /usr/local/bin/
install -d -o '$NEW_USER' -g '$NEW_USER' '/home/$NEW_USER/.local/share/fonts'
cp -a /var/local/anarchy-dots/sys/fonts/. '/home/$NEW_USER/.local/share/fonts/'
chsh -s /bin/zsh '$NEW_USER'

# Vesktop's package archive is over GitHub's per-file Git limit. Build the AUR
# package from its upstream release during installation instead of bundling it.
pacman --config /etc/pacman.conf.arch -Syy --noconfirm
pacman --config /etc/pacman.conf.arch -S --needed --noconfirm alsa-lib gtk3 nss
rm -rf /tmp/vesktop-bin
runuser -u '$NEW_USER' -- git clone --depth 1 https://aur.archlinux.org/vesktop-bin.git /tmp/vesktop-bin
runuser -u '$NEW_USER' -- bash -c 'cd /tmp/vesktop-bin && makepkg --noconfirm'
pacman -U --noconfirm /tmp/vesktop-bin/vesktop-bin-*.pkg.tar.zst
rm -rf /tmp/vesktop-bin /etc/pacman.conf.arch
systemctl enable NetworkManager sddm
rm -rf /var/local/anarchy-dots
EOF
then
    fail 'Installed system configuration failed.'
    exit 1
fi
ok 'Installation complete. Reboot when ready.'
