def load_pywal_palette(home: Path | None = None) -> dict[str, str]:
    """Load pywal colors from ~/.cache/wal, with a safe built-in fallback."""
    cache_dir = (home or Path.home()) / ".cache" / "wal"
    special: dict[str, str] = {}
    colors: dict[str, str] = {}
    color_pattern = re.compile(r"^#[0-9a-fA-F]{6}$")

    try:
        data = json.loads((cache_dir / "colors.json").read_text(encoding="utf-8"))
        if isinstance(data, dict):
            raw_special = data.get("special", {})
            raw_colors = data.get("colors", {})
            if isinstance(raw_special, dict):
                special = raw_special
            if isinstance(raw_colors, dict):
                colors = raw_colors
    except (OSError, json.JSONDecodeError):
        pass

    # pywal's plain colors file is a useful fallback for older cache formats.
    if not colors:
        try:
            lines = (cache_dir / "colors").read_text(encoding="utf-8").splitlines()
            if len(lines) >= 16 and all(color_pattern.fullmatch(line.strip()) for line in lines[:16]):
                colors = {f"color{index}": line.strip() for index, line in enumerate(lines[:16])}
        except OSError:
            pass

    def color(value: object, fallback: str) -> str:
        return value if isinstance(value, str) and color_pattern.fullmatch(value) else fallback

    background = color(
        special.get("background"),
        color(colors.get("color0"), FALLBACK_PYWAL["background"]),
    )
    foreground = color(
        special.get("foreground"),
        color(colors.get("color7"), FALLBACK_PYWAL["foreground"]),
    )
    palette = {
        "background": background,
        "foreground": foreground,
    }
    for index in range(9):
        key = f"color{index}"
        palette[key] = color(colors.get(key), FALLBACK_PYWAL.get(key, foreground))
    return palette


def blend_colors(base: str, accent: str, amount: float) -> str:
    """Mix two #RRGGBB colors for layered surfaces that follow pywal."""
    base_rgb = tuple(int(base[index : index + 2], 16) for index in (1, 3, 5))
    accent_rgb = tuple(int(accent[index : index + 2], 16) for index in (1, 3, 5))
    mixed = tuple(round(a * (1 - amount) + b * amount) for a, b in zip(base_rgb, accent_rgb))
    return "#" + "".join(f"{channel:02x}" for channel in mixed)


def color_luminance(value: str) -> float:
    """Return relative luminance for a validated hex color."""
    channels = [int(value[index : index + 2], 16) / 255 for index in (1, 3, 5)]
    linear = [channel / 12.92 if channel <= 0.04045 else ((channel + 0.055) / 1.055) ** 2.4 for channel in channels]
    return 0.2126 * linear[0] + 0.7152 * linear[1] + 0.0722 * linear[2]


def contrasting_text(fill: str, light: str, dark: str) -> str:
    """Pick the pywal foreground/background with better contrast on a fill."""
    return dark if color_luminance(fill) > 0.5 else light


def run_capture(command: list[str]) -> str:
    """Run a non-interactive discovery command and return its output."""
    try:
        result = subprocess.run(
            command, check=True, capture_output=True, text=True, timeout=12
        )
    except (OSError, subprocess.SubprocessError):
        return ""
    return result.stdout.strip()


def find_backend() -> Path | None:
    """Find the installed or colocated shell installer backend."""
    return next((candidate for candidate in BACKEND_CANDIDATES if candidate.is_file()), None)


def available_disks() -> list[tuple[str, str]]:
    """Return installable block disks as (device path, display label)."""
    output = run_capture(
        ["lsblk", "--json", "--nodeps", "-o", "NAME,SIZE,MODEL,TYPE,RO"]
    )
    if not output:
        return []
    try:
        import json

        devices = json.loads(output).get("blockdevices", [])
    except (ValueError, AttributeError):
        return []

    disks: list[tuple[str, str]] = []
    for device in devices:
        if device.get("type") != "disk" or device.get("ro") in (1, True, "1", "true"):
            continue
        name = str(device.get("name", ""))
        if not name or name.startswith("loop") or name.startswith("sr"):
            continue
        model = str(device.get("model") or "Disk").strip()
        size = str(device.get("size") or "Unknown size")
        disks.append((f"/dev/{name}", f"{name}  ·  {size}  ·  {model}"))
    return disks


def available_timezones() -> list[str]:
    """Return system timezones, falling back to UTC when unavailable."""
    result = run_capture(["timedatectl", "list-timezones"])
    zones = result.splitlines() if result else []
    return zones or ["UTC"]


