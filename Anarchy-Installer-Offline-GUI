    def _confirm_reboot(self, dialog: Gtk.AlertDialog, result: Gio.AsyncResult) -> None:
        try:
            response = dialog.choose_finish(result)
        except GLib.Error:
            return
        if response != 1:
            return
        if os.geteuid() == 0 or self._sudo_is_ready():
            self._reboot(None)
        else:
            self._show_reboot_sudo_dialog()

    def _show_reboot_sudo_dialog(self) -> None:
        assert self.window is not None
        dialog = Gtk.Dialog(title="Authorize reboot", transient_for=self.window, modal=True)
        dialog.add_button("Cancel", Gtk.ResponseType.CANCEL)
        dialog.add_button("Reboot now", Gtk.ResponseType.OK)
        dialog.set_default_response(Gtk.ResponseType.OK)
        area = dialog.get_content_area()
        area.set_spacing(12)
        area.set_margin_top(18)
        area.set_margin_bottom(18)
        area.set_margin_start(20)
        area.set_margin_end(20)
        area.append(self._label("Enter your live-session password to reboot the system.", "description"))
        password = self._password_entry("Live-session password")
        area.append(password)

        def response_handler(_dialog: Gtk.Dialog, response_id: int) -> None:
            secret = password.get_text()
            dialog.destroy()
            if response_id == Gtk.ResponseType.OK and secret:
                self._reboot(secret)

        dialog.connect("response", response_handler)
        dialog.present()

    def _reboot(self, sudo_password: str | None) -> None:
        if self.reboot_button:
            self.reboot_button.set_sensitive(False)
        if os.geteuid() == 0:
            command = ["systemctl", "reboot"]
        elif sudo_password is None:
            command = ["sudo", "-n", "--", "systemctl", "reboot"]
        else:
            command = ["sudo", "-k", "-S", "--", "systemctl", "reboot"]

        def run() -> None:
            try:
                process = subprocess.Popen(
                    command,
                    stdin=subprocess.PIPE if sudo_password is not None else subprocess.DEVNULL,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    text=True,
                )
                if process.stdin is not None:
                    process.stdin.write(sudo_password + "\n")
                    process.stdin.close()
                return_code = process.wait()
            except OSError as error:
                GLib.idle_add(self._reboot_failed, str(error))
                return
            if return_code != 0:
                GLib.idle_add(self._reboot_failed, "systemctl reboot exited with a non-zero status")

        threading.Thread(target=run, daemon=True).start()

    def _reboot_failed(self, reason: str) -> bool:
        if self.reboot_button:
            self.reboot_button.set_sensitive(True)
        if self.window is not None:
            dialog = Gtk.AlertDialog(message="Could not reboot automatically.")
            dialog.set_detail(f"{reason}. Reboot the system manually.")
            dialog.show(self.window)
        return GLib.SOURCE_REMOVE

    @staticmethod
    def _sudo_is_ready() -> bool:
        """Check whether sudo can authorize non-interactively."""
        try:
            return subprocess.run(
                ["sudo", "-n", "true"],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=5,
                check=False,
            ).returncode == 0
        except (OSError, subprocess.SubprocessError):
            return False

