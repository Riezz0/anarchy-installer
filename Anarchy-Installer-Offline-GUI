    @staticmethod
    def _label(text: str, css_class: str | None = None) -> Gtk.Label:
        label = Gtk.Label(label=text)
        label.set_xalign(0)
        label.set_wrap(True)
        if css_class:
            label.add_css_class(css_class)
        return label

    @staticmethod
    def _vbox(spacing: int = 12) -> Gtk.Box:
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=spacing)
        return box

    @staticmethod
    def _card(title: str, subtitle: str, child: Gtk.Widget) -> Gtk.Box:
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        card.add_css_class("card")
        card.append(OfflineInstaller._label(title, "card-title"))
        if subtitle:
            card.append(OfflineInstaller._label(subtitle, "muted"))
        card.append(child)
        return card

    @staticmethod
    def _field(label: str, widget: Gtk.Widget) -> Gtk.Box:
        row = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=7)
        row.append(OfflineInstaller._label(label, "field-label"))
        row.append(widget)
        return row

    def _build_window(self) -> None:
        self.window = Gtk.ApplicationWindow(application=self, title="Anarchy-Linux Installer")
        self.window.set_default_size(1020, 740)
        self.window.set_size_request(780, 620)
        self.window.connect("close-request", self._on_close_request)

        shell = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        shell.add_css_class("app-shell")
        shell.append(self._build_header())

        body = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        body.append(self._build_sidebar())
        content = self._vbox(0)
        content.set_hexpand(True)
        content.set_vexpand(True)
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.stack.set_transition_duration(180)
        self.stack.set_hexpand(True)
        self.stack.set_vexpand(True)
        for name, page in (
            ("welcome", self._build_welcome_page()),
            ("account", self._build_account_page()),
            ("options", self._build_options_page()),
            ("review", self._build_review_page()),
            ("progress", self._build_progress_page()),
        ):
            self.stack.add_named(page, name)
        content.append(self.stack)
        body.append(content)
        shell.append(body)
        shell.append(self._build_footer())
        self.window.set_child(shell)
        self._show_page(0)

    def _brand_logo(self) -> Gtk.Widget:
        """Draw the two-tone Anarchy-Shell mark used across the desktop."""
        logo = Gtk.DrawingArea()
        logo.add_css_class("brand-logo")
        logo.set_size_request(46, 46)
        accent = Gdk.RGBA()
        if not accent.parse(self.brand_accent):
            accent.parse(FALLBACK_PYWAL["color4"])
        foreground = Gdk.RGBA()
        if not foreground.parse(self.brand_foreground):
            foreground.parse(FALLBACK_PYWAL["foreground"])
        left_half = ((12.0, 2.0), (3.0, 21.0), (8.0, 21.0), (12.0, 11.0))
        right_half = ((12.0, 2.0), (12.0, 11.0), (16.0, 21.0), (21.0, 21.0))

        def draw(_area: Gtk.DrawingArea, cr: cairo.Context, width: int, height: int) -> None:
            def fill(colour: Gdk.RGBA, points: tuple[tuple[float, float], ...]) -> None:
                cr.set_source_rgba(colour.red, colour.green, colour.blue, colour.alpha)
                cr.move_to(*points[0])
                for x, y in points[1:]:
                    cr.line_to(x, y)
                cr.close_path()
                cr.fill()

            scale = min(width, height) / 24
            cr.save()
            cr.translate((width - 24 * scale) / 2, (height - 24 * scale) / 2)
            cr.scale(scale, scale)
            fill(accent, left_half)
            fill(foreground, right_half)
            cr.restore()

        logo.set_draw_func(draw)
        return logo

    def _build_header(self) -> Gtk.Widget:
        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=13)
        header.add_css_class("topbar")
        header.append(self._brand_logo())
        brand = self._vbox(2)
        brand.append(self._label("Anarchy-Linux Installer", "brand-title"))
        brand.append(self._label("A guided installation for your system", "brand-subtitle"))
        header.append(brand)
        spacer = Gtk.Box()
        spacer.set_hexpand(True)
        header.append(spacer)
        badge = self._label("●  OFFLINE REPOSITORY", "muted")
        header.append(badge)
        return header

    def _build_sidebar(self) -> Gtk.Widget:
        sidebar = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=17)
        sidebar.add_css_class("sidebar")
        sidebar.set_size_request(205, -1)
        sidebar.append(self._label("INSTALLATION", "muted"))
        for index, name in enumerate(("Drive", "Account", "Customize", "Review"), start=1):
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=11)
            number = self._label(str(index), "step-number")
            number.set_xalign(0.5)
            number.set_yalign(0.5)
            self.step_labels.append(number)
            row.append(number)
            row.append(self._label(name, "field-label"))
            sidebar.append(row)
        spacer = Gtk.Box()
        spacer.set_vexpand(True)
        sidebar.append(spacer)
        sidebar.append(self._label("Your bundled packages and dotfiles stay local. Optional network features are clearly marked.", "muted"))
