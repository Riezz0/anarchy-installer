        password = self._password_entry("Live-session password")
        area.append(password)

        def response_handler(_dialog: Gtk.Dialog, response_id: int) -> None:
            secret = password.get_text()
            dialog.destroy()
            if response_id == Gtk.ResponseType.OK and secret:
                self._begin_install(secret)

        dialog.connect("response", response_handler)
        dialog.present()

    def _write_config(self) -> Path:
        assert self.username_entry and self.user_password and self.root_password
        assert self.timezone_dropdown and self.helper_dropdown
        assert self.nct_check and self.chaotic_check
        disk = self._selected_disk()
        if disk is None:
            raise RuntimeError("No target drive is selected")
        values = (
            disk[0],
            self.username_entry.get_text().strip(),
            self.user_password.get_text(),
            self.root_password.get_text(),
            self._selected(self.timezone_dropdown, self.timezones),
            self._selected(self.helper_dropdown, ["yay", "paru", "pikaur"]),
            "true" if self.nct_check.get_active() else "false",
            "true" if self.chaotic_check.get_active() else "false",
        )
        fd, filename = tempfile.mkstemp(prefix="anarchy-offline-", dir="/tmp")
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "wb") as config:
            config.write(b"\0".join(value.encode("utf-8") for value in values) + b"\0")
        self.user_password.set_text("")
        self.user_password_confirm.set_text("")
        self.root_password.set_text("")
        self.root_password_confirm.set_text("")
        self.config_path = Path(filename)
        return self.config_path

    def _begin_install(self, sudo_password: str | None) -> None:
        backend = find_backend()
        if backend is None:
            self._error("Could not find Anarchy-Installer-Offline next to this app or in /usr/local/bin.")
            return
        try:
            config = self._write_config()
        except (OSError, RuntimeError) as error:
            self._error(f"Could not prepare secure installer settings: {error}")
            return

        if os.geteuid() == 0:
            command = ["env", f"ANARCHY_INSTALLER_CONFIG={config}", "bash", str(backend)]
        elif sudo_password is None:
            command = [
                "sudo", "-n", "--", "env",
                f"ANARCHY_INSTALLER_CONFIG={config}", "bash", str(backend),
            ]
        else:
            if shutil.which("sudo") is None:
                self._remove_config()
                self._error("sudo is not available in this live environment.")
                return
            command = [
                "sudo", "-k", "-S", "--", "env",
                f"ANARCHY_INSTALLER_CONFIG={config}", "bash", str(backend),
            ]

        self._show_page(4)
        self.install_started = True
        if self.next_button:
            self.next_button.set_visible(False)
        assert self.log_buffer is not None
        self.log_buffer.set_text("")
        self._update_phase(0, "Starting the installer…")
        threading.Thread(
            target=self._run_installer,
            args=(command, sudo_password),
            daemon=True,
        ).start()

    def _run_installer(self, command: list[str], sudo_password: str | None) -> None:
        process: subprocess.Popen[str] | None = None
        try:
            process = subprocess.Popen(
                command,
                stdin=subprocess.PIPE if sudo_password is not None else subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                bufsize=1,
                env=os.environ.copy(),
            )
            if process.stdin is not None:
                process.stdin.write((sudo_password or "") + "\n")
                process.stdin.close()
            if process.stdout is not None:
                for line in process.stdout:
                    GLib.idle_add(self._append_log, line.rstrip("\n"))
            return_code = process.wait()
            GLib.idle_add(self._finish_install, return_code)
        except OSError as error:
            GLib.idle_add(self._append_log, f"Could not start installer: {error}")
            GLib.idle_add(self._finish_install, 1)
        finally:
            self._remove_config()

    def _append_log(self, line: str) -> bool:
        if line.startswith("ANARCHY_STEP:"):
            title = line.removeprefix("ANARCHY_STEP:")
            if title.startswith(("Partitioning", "Formatting", "Creating Btrfs", "Mounting target")):
                self._update_phase(0, title)
            elif title.startswith(("Configuring strict offline", "Installing packages", "Generating fstab")):
                self._update_phase(1, title)
            elif title.startswith("Configuring the installed system"):
                self._update_phase(2, title)
            elif title.startswith(("Seeding official", "Unmounting target")):
                self._update_phase(3, title)
            return GLib.SOURCE_REMOVE
        if self.log_buffer is not None:
            at_bottom = self._log_is_at_bottom()
            end = self.log_buffer.get_end_iter()
            self.log_buffer.insert(end, line + "\n")
            if at_bottom:
                GLib.idle_add(self._scroll_log_to_end)
        if self.activity_label and re.search(r"(error|failed|fatal):", line, re.IGNORECASE):
            self.activity_label.set_text("An issue was reported. Open detailed output for the full message.")
            self.activity_label.add_css_class("warning-text")
        return GLib.SOURCE_REMOVE

    def _log_is_at_bottom(self) -> bool:
        """Return True when the output view is following the end of the log."""
        if self.log_scroll is None:
            return True
        adjustment = self.log_scroll.get_vadjustment()
        if adjustment is None:
            return True
        upper = adjustment.get_upper()
        page_size = adjustment.get_page_size()
        return adjustment.get_value() >= upper - page_size - 4

    def _scroll_log_to_end(self) -> bool:
        if self.log_view is None or self.log_buffer is None:
            return GLib.SOURCE_REMOVE
        end = self.log_buffer.get_end_iter()
        self.log_view.scroll_to_iter(end, 0.0, True, 0.0, 1.0)
        return GLib.SOURCE_REMOVE

    def _on_log_expanded(self, expander: Gtk.Expander, _pspec: object) -> None:
        if expander.get_expanded():
            GLib.idle_add(self._scroll_log_to_end)

    def _update_phase(self, phase: int, activity: str) -> None:
        """Update the high-level install checklist and progress indicator."""
        self.current_phase = max(0, min(phase, len(self.phase_rows) - 1))
        for index, (row, indicator, _title) in enumerate(self.phase_rows):
            row.remove_css_class("phase-active")
            row.remove_css_class("phase-done")
            if index < self.current_phase:
                row.add_css_class("phase-done")
                indicator.set_text("✓")
            elif index == self.current_phase:
                row.add_css_class("phase-active")
                indicator.set_text("●")
            else:
                indicator.set_text("○")
        if self.progress_bar:
            self.progress_bar.set_fraction((self.current_phase + 0.35) / 4)
            self.progress_bar.set_text(f"STEP {self.current_phase + 1} OF 4")
        if self.activity_label:
            self.activity_label.set_text(activity)
            self.activity_label.remove_css_class("warning-text")

    def _finish_install(self, return_code: int) -> bool:
        self.install_finished = True
        if self.progress_label:
            self.progress_label.set_text(
                "Installation complete — you can reboot now."
                if return_code == 0
                else "Installation stopped. Review the log for details."
            )
            self.progress_label.remove_css_class("card-title")
            self.progress_label.add_css_class("success-title" if return_code == 0 else "error-title")
        if return_code == 0:
            for _row, indicator, _title in self.phase_rows:
                indicator.set_text("✓")
            for row, _indicator, _title in self.phase_rows:
                row.remove_css_class("phase-active")
                row.add_css_class("phase-done")
            if self.progress_bar:
                self.progress_bar.set_fraction(1.0)
                self.progress_bar.set_text("COMPLETE")
            if self.activity_label:
                self.activity_label.set_text("Your system is installed. You can reboot when ready.")
            if self.reboot_button:
                self.reboot_button.set_visible(True)
        else:
            if self.progress_bar:
                self.progress_bar.set_text("INSTALLATION NEEDS ATTENTION")
            if self.activity_label:
                self.activity_label.set_text("The install stopped. Expand detailed output to inspect the error.")
                self.activity_label.add_css_class("warning-text")
            if self.log_expander:
                self.log_expander.set_expanded(True)
        if self.page_counter:
            self.page_counter.set_text("COMPLETE" if return_code == 0 else "NEEDS ATTENTION")
        if self.back_button:
            self.back_button.set_visible(False)
        if self.next_button:
            self.next_button.set_visible(True)
            self.next_button.set_label("Close")
            self.next_button.set_sensitive(True)
            self.next_button.remove_css_class("suggested-action")
        return GLib.SOURCE_REMOVE

    def _on_close_request(self, _window: Gtk.Window) -> bool:
        """Keep the installer visible while it is modifying the disk."""
        if self.install_started and not self.install_finished:
            return True
        return False

    def _remove_config(self) -> None:
        if self.config_path is not None:
            try:
                self.config_path.unlink(missing_ok=True)
            except OSError:
                pass
            self.config_path = None


def main() -> int:
    """Launch the GTK wizard."""
    if not Gtk.init_check():
        print(
            "Could not connect to the desktop display. Start the GUI from your logged-in session without sudo.",
            file=sys.stderr,
        )
        return 1
    GLib.set_application_name("Anarchy-Linux Installer")
    app = OfflineInstaller()
    return app.run(None)


if __name__ == "__main__":
    raise SystemExit(main())
