    def _validate_current(self) -> bool:
        assert self.window is not None
        if self.current_page == 0:
            if not self.repository_ready or not self.dotfiles_ready:
                self._error("The offline package repository or dotfiles bundle is missing. Rebuild the ISO with both bundles included.")
                return False
            selected = self._selected_disk()
            if selected is None:
                self._error("No writable drive was detected. Check the live system and try again.")
                return False
            if not Path("/sys/firmware/efi").is_dir():
                self._error("Boot the live USB in UEFI mode before installing.")
                return False
        elif self.current_page == 1:
            assert self.username_entry and self.user_password and self.user_password_confirm
            assert self.root_password and self.root_password_confirm
            username = self.username_entry.get_text().strip()
            if not re.fullmatch(r"[a-z_][a-z0-9_-]*", username):
                self._error("Enter a lowercase username using letters, numbers, _ or -.")
                return False
            if not self.user_password.get_text():
                self._error("The user password cannot be empty.")
                return False
            if self.user_password.get_text() != self.user_password_confirm.get_text():
                self._error("The user password fields do not match.")
                return False
            if not self.root_password.get_text():
                self._error("The root password cannot be empty.")
                return False
            if self.root_password.get_text() != self.root_password_confirm.get_text():
                self._error("The root password fields do not match.")
                return False
        elif self.current_page == 2:
            assert self.timezone_dropdown is not None
            if not self._selected(self.timezone_dropdown, self.timezones):
                self._error("Select a timezone to continue.")
                return False
        return True

    def _on_next(self, _button: Gtk.Button) -> None:
        if self.install_finished:
            self.quit()
        elif self.current_page < 3:
            if not self._validate_current():
                return
            if self.current_page == 2:
                self._refresh_review()
            self._show_page(self.current_page + 1)
        else:
            self._request_install()

    def _show_page(self, page: int) -> None:
        if page < 0 or page > 4 or self.stack is None:
            return
        self.current_page = page
        names = ("welcome", "account", "options", "review", "progress")
        titles = ("Choose a drive", "Create an account", "Customize your install", "Review your choices", "Installing Anarchy")
        self.stack.set_visible_child_name(names[page])
        if self.page_title:
            self.page_title.set_text(titles[page])
        if self.page_counter:
            self.page_counter.set_text("INSTALLING" if page == 4 else f"STEP {page + 1} OF 4")
        if self.back_button:
            self.back_button.set_visible(page < 3)
            self.back_button.set_sensitive(page > 0)
        if self.next_button:
            self.next_button.set_visible(page < 4)
            button_labels = {
                0: "Account details  →",
                1: "Customize  →",
                2: "Review install  →",
                3: "Start installation",
            }
            self.next_button.set_label(button_labels.get(page, "Continue  →"))
            self.next_button.set_sensitive(page < 4)
        if self.reboot_button:
            self.reboot_button.set_visible(False)
        for index, label in enumerate(self.step_labels):
            label.remove_css_class("step-active")
            label.remove_css_class("step-done")
            if index < page:
                label.add_css_class("step-done")
            elif index == page:
                label.add_css_class("step-active")

