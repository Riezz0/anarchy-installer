    def _selected(self, dropdown: Gtk.DropDown, values: list[str]) -> str:
        index = dropdown.get_selected()
        if index >= len(values):
            return ""
        return values[index]

    def _selected_disk(self) -> tuple[str, str] | None:
        if self.disk_dropdown is None or not self.disks:
            return None
        index = self.disk_dropdown.get_selected()
        return self.disks[index] if index < len(self.disks) else None

    def _validate_current(self) -> bool:
        assert self.window is not None
        if self.current_page == 0:
            if not self.repository_ready or not self.dotfiles_ready:
                self._error("The offline package repository or dotfiles bundle is missing. Rebuild the ISO with both bundles included.")
                return False
            selected = self._selected_disk()
            if selected is None:
                self._error("No writable drive was detected. Check the live system and try again.")
                return False
            if not Path("/sys/firmware/efi").is_dir():
                self._error("Boot the live USB in UEFI mode before installing.")
                return False
        elif self.current_page == 1:
            assert self.username_entry and self.user_password and self.user_password_confirm
            assert self.root_password and self.root_password_confirm
            username = self.username_entry.get_text().strip()
            if not re.fullmatch(r"[a-z_][a-z0-9_-]*", username):
                self._error("Enter a lowercase username using letters, numbers, _ or -.")
                return False
            if not self.user_password.get_text():
                self._error("The user password cannot be empty.")
                return False
            if self.user_password.get_text() != self.user_password_confirm.get_text():
                self._error("The user password fields do not match.")
                return False
            if not self.root_password.get_text():
                self._error("The root password cannot be empty.")
                return False
            if self.root_password.get_text() != self.root_password_confirm.get_text():
                self._error("The root password fields do not match.")
                return False
        elif self.current_page == 2:
            assert self.timezone_dropdown is not None
            if not self._selected(self.timezone_dropdown, self.timezones):
                self._error("Select a timezone to continue.")
                return False
        return True

    def _on_next(self, _button: Gtk.Button) -> None:
        if self.install_finished:
            self.quit()
        elif self.current_page < 3:
            if not self._validate_current():
                return
            if self.current_page == 2:
                self._refresh_review()
            self._show_page(self.current_page + 1)
        else:
            self._request_install()

    def _show_page(self, page: int) -> None:
        if page < 0 or page > 4 or self.stack is None:
            return
        self.current_page = page
        names = ("welcome", "account", "options", "review", "progress")
        titles = ("Choose a drive", "Create an account", "Customize your install", "Review your choices", "Installing Anarchy")
        self.stack.set_visible_child_name(names[page])
        if self.page_title:
            self.page_title.set_text(titles[page])
        if self.page_counter:
            self.page_counter.set_text("INSTALLING" if page == 4 else f"STEP {page + 1} OF 4")
        if self.back_button:
            self.back_button.set_visible(page < 3)
            self.back_button.set_sensitive(page > 0)
        if self.next_button:
            self.next_button.set_visible(page < 4)
            button_labels = {
                0: "Account details  →",
                1: "Customize  →",
                2: "Review install  →",
                3: "Start installation",
            }
            self.next_button.set_label(button_labels.get(page, "Continue  →"))
            self.next_button.set_sensitive(page < 4)
        for index, label in enumerate(self.step_labels):
            label.remove_css_class("step-active")
            label.remove_css_class("step-done")
            if index < page:
                label.add_css_class("step-done")
            elif index == page:
                label.add_css_class("step-active")

    def _refresh_review(self) -> None:
        assert self.review_label and self.username_entry and self.timezone_dropdown
        assert self.helper_dropdown and self.nct_check and self.chaotic_check
        disk = self._selected_disk()
        disk_name = disk[1] if disk else "No drive"
        values = (
            ("Target drive", disk_name),
            ("User", self.username_entry.get_text().strip()),
            ("Hostname", "arch-zen-hyprland"),
            ("Timezone", self._selected(self.timezone_dropdown, self.timezones)),
            ("AUR helper", self._selected(self.helper_dropdown, ["yay", "paru", "pikaur"])),
            ("NCT6687D", "Enabled" if self.nct_check.get_active() else "Disabled"),
            ("Chaotic-AUR", "Enabled" if self.chaotic_check.get_active() else "Disabled"),
        )
        self.review_label.set_text("\n".join(f"{label:<14} {value}" for label, value in values))

    def _error(self, message: str) -> None:
        assert self.window is not None
        dialog = Gtk.AlertDialog(message=message)
        dialog.set_detail("Please check the highlighted settings and try again.")
        dialog.show(self.window)

    def _request_install(self) -> None:
        assert self.window is not None
        disk = self._selected_disk()
        if disk is None:
            self._error("No install drive is selected.")
            return
        dialog = Gtk.AlertDialog(
            message=f"Erase {disk[0]} and install Anarchy?",
            detail="All data on this drive will be destroyed. This cannot be undone.",
            buttons=["Cancel", "Erase drive and install"],
            default_button=0,
            cancel_button=0,
        )
        dialog.choose(self.window, None, self._confirm_install)

    def _confirm_install(self, dialog: Gtk.AlertDialog, result: Gio.AsyncResult) -> None:
        try:
            response = dialog.choose_finish(result)
        except GLib.Error:
            return
        if response == 1:
            if os.geteuid() == 0:
                self._begin_install(None)
            elif self._sudo_is_ready():
                self._begin_install(None)
            else:
                self._show_sudo_dialog()

    @staticmethod
    def _sudo_is_ready() -> bool:
        """Check whether sudo can authorize non-interactively."""
        try:
            return subprocess.run(
                ["sudo", "-n", "true"],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=5,
                check=False,
            ).returncode == 0
        except (OSError, subprocess.SubprocessError):
            return False

    def _show_sudo_dialog(self) -> None:
        assert self.window is not None
        dialog = Gtk.Dialog(title="Authorize installation", transient_for=self.window, modal=True)
        dialog.add_button("Cancel", Gtk.ResponseType.CANCEL)
        dialog.add_button("Authorize", Gtk.ResponseType.OK)
        dialog.set_default_response(Gtk.ResponseType.OK)
        area = dialog.get_content_area()
        area.set_spacing(12)
        area.set_margin_top(18)
        area.set_margin_bottom(18)
        area.set_margin_start(20)
        area.set_margin_end(20)
        area.append(self._label("Enter your live-session password to authorize the disk installation.", "description"))
        password = self._password_entry("Live-session password")
        area.append(password)

        def response_handler(_dialog: Gtk.Dialog, response_id: int) -> None:
            secret = password.get_text()
            dialog.destroy()
            if response_id == Gtk.ResponseType.OK and secret:
                self._begin_install(secret)

        dialog.connect("response", response_handler)
        dialog.present()

    def _write_config(self) -> Path:
        assert self.username_entry and self.user_password and self.root_password
        assert self.timezone_dropdown and self.helper_dropdown
        assert self.nct_check and self.chaotic_check
        disk = self._selected_disk()
        if disk is None:
            raise RuntimeError("No target drive is selected")
        values = (
            disk[0],
            self.username_entry.get_text().strip(),
            self.user_password.get_text(),
            self.root_password.get_text(),
            self._selected(self.timezone_dropdown, self.timezones),
            self._selected(self.helper_dropdown, ["yay", "paru", "pikaur"]),
            "true" if self.nct_check.get_active() else "false",
            "true" if self.chaotic_check.get_active() else "false",
        )
        fd, filename = tempfile.mkstemp(prefix="anarchy-offline-", dir="/tmp")
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "wb") as config:
            config.write(b"\0".join(value.encode("utf-8") for value in values) + b"\0")
        self.user_password.set_text("")
        self.user_password_confirm.set_text("")
        self.root_password.set_text("")
        self.root_password_confirm.set_text("")
        self.config_path = Path(filename)
        return self.config_path

    def _begin_install(self, sudo_password: str | None) -> None:
        backend = find_backend()
        if backend is None:
            self._error("Could not find Anarchy-Installer-Offline next to this app or in /usr/local/bin.")
            return
        try:
            config = self._write_config()
        except (OSError, RuntimeError) as error:
            self._error(f"Could not prepare secure installer settings: {error}")
            return

        if os.geteuid() == 0:
            command = ["env", f"ANARCHY_INSTALLER_CONFIG={config}", "bash", str(backend)]
        elif sudo_password is None:
            command = [
                "sudo", "-n", "--", "env",
                f"ANARCHY_INSTALLER_CONFIG={config}", "bash", str(backend),
            ]
        else:
            if shutil.which("sudo") is None:
                self._remove_config()
                self._error("sudo is not available in this live environment.")
                return
            command = [
                "sudo", "-k", "-S", "--", "env",
                f"ANARCHY_INSTALLER_CONFIG={config}", "bash", str(backend),
            ]

        self._show_page(4)
        self.install_started = True
        if self.next_button:
            self.next_button.set_visible(False)
        if self.spinner:
            self.spinner.start()
        assert self.log_buffer is not None
        self.log_buffer.set_text("Starting the installer…\n")
        threading.Thread(
            target=self._run_installer,
            args=(command, sudo_password),
            daemon=True,
        ).start()

    def _run_installer(self, command: list[str], sudo_password: str) -> None:
        process: subprocess.Popen[str] | None = None
        try:
            process = subprocess.Popen(
                command,
                stdin=subprocess.PIPE if sudo_password is not None else subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                bufsize=1,
                env=os.environ.copy(),
            )
            if process.stdin is not None:
                process.stdin.write((sudo_password or "") + "\n")
                process.stdin.close()
            if process.stdout is not None:
                for line in process.stdout:
                    GLib.idle_add(self._append_log, line.rstrip("\n"))
            return_code = process.wait()
            GLib.idle_add(self._finish_install, return_code)
        except OSError as error:
            GLib.idle_add(self._append_log, f"Could not start installer: {error}")
            GLib.idle_add(self._finish_install, 1)
        finally:
            self._remove_config()

    def _append_log(self, line: str) -> bool:
        if line.startswith("ANARCHY_STEP:"):
            if self.progress_label:
                self.progress_label.set_text(line.removeprefix("ANARCHY_STEP:"))
            return GLib.SOURCE_REMOVE
        if self.log_buffer is not None:
            end = self.log_buffer.get_end_iter()
            self.log_buffer.insert(end, line + "\n")
        return GLib.SOURCE_REMOVE

    def _finish_install(self, return_code: int) -> bool:
        self.install_finished = True
        if self.spinner:
            self.spinner.stop()
        if self.progress_label:
            self.progress_label.set_text(
                "Installation complete — you can reboot now."
                if return_code == 0
                else "Installation stopped. Review the log for details."
            )
            self.progress_label.remove_css_class("card-title")
            self.progress_label.add_css_class("success-title" if return_code == 0 else "error-title")
        if self.page_counter:
            self.page_counter.set_text("COMPLETE" if return_code == 0 else "NEEDS ATTENTION")
        if self.back_button:
            self.back_button.set_visible(False)
        if self.next_button:
            self.next_button.set_visible(True)
            self.next_button.set_label("Close")
            self.next_button.set_sensitive(True)
            self.next_button.remove_css_class("suggested-action")
        if self.log_buffer is not None and return_code == 0:
            end = self.log_buffer.get_end_iter()
            self.log_buffer.insert(
                end,
                "\nInstallation completed. You may close this window and reboot.\n",
            )
        return GLib.SOURCE_REMOVE

    def _on_close_request(self, _window: Gtk.Window) -> bool:
        """Keep the installer visible while it is modifying the disk."""
        if self.install_started and not self.install_finished:
            return True
        return False

    def _remove_config(self) -> None:
        if self.config_path is not None:
            try:
                self.config_path.unlink(missing_ok=True)
            except OSError:
                pass
            self.config_path = None


def main() -> int:
    """Launch the GTK wizard."""
    if not Gtk.init_check():
        print(
            "Could not connect to the desktop display. Start the GUI from your logged-in session without sudo.",
            file=sys.stderr,
        )
        return 1
    app = OfflineInstaller()
    return app.run(None)


if __name__ == "__main__":
    raise SystemExit(main())
