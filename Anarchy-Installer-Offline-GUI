def run_capture(command: list[str]) -> str:
    """Run a non-interactive discovery command and return its output."""
    try:
        result = subprocess.run(
            command, check=True, capture_output=True, text=True, timeout=12
        )
    except (OSError, subprocess.SubprocessError):
        return ""
    return result.stdout.strip()


def find_backend() -> Path | None:
    """Find the installed or colocated shell installer backend."""
    return next((candidate for candidate in BACKEND_CANDIDATES if candidate.is_file()), None)


def available_disks() -> list[tuple[str, str]]:
    """Return installable block disks as (device path, display label)."""
    output = run_capture(
        ["lsblk", "--json", "--nodeps", "-o", "NAME,SIZE,MODEL,TYPE,RO"]
    )
    if not output:
        return []
    try:
        import json

        devices = json.loads(output).get("blockdevices", [])
    except (ValueError, AttributeError):
        return []

    disks: list[tuple[str, str]] = []
    for device in devices:
        if device.get("type") != "disk" or device.get("ro") in (1, True, "1", "true"):
            continue
        name = str(device.get("name", ""))
        if not name or name.startswith("loop") or name.startswith("sr"):
            continue
        model = str(device.get("model") or "Disk").strip()
        size = str(device.get("size") or "Unknown size")
        disks.append((f"/dev/{name}", f"{name}  ·  {size}  ·  {model}"))
    return disks


def available_timezones() -> list[str]:
    """Return system timezones, falling back to UTC when unavailable."""
    result = run_capture(["timedatectl", "list-timezones"])
    zones = result.splitlines() if result else []
    return zones or ["UTC"]


class OfflineInstaller(Gtk.Application):
    """Wizard UI and secure handoff to the existing shell installer."""

    def __init__(self) -> None:
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.window: Gtk.ApplicationWindow | None = None
        self.stack: Gtk.Stack | None = None
        self.page_title: Gtk.Label | None = None
        self.page_counter: Gtk.Label | None = None
        self.back_button: Gtk.Button | None = None
        self.next_button: Gtk.Button | None = None
        self.step_labels: list[Gtk.Label] = []
        self.current_page = 0
        self.disks = available_disks()
        self.timezones = available_timezones()
        self.repository_ready = (OFFLINE_REPO / "offline_repo.db").is_file()
        self.dotfiles_ready = DOTFILES_DIR.is_dir()
        self.disk_dropdown: Gtk.DropDown | None = None
        self.username_entry: Gtk.Entry | None = None
        self.user_password: Gtk.PasswordEntry | None = None
        self.user_password_confirm: Gtk.PasswordEntry | None = None
        self.root_password: Gtk.PasswordEntry | None = None
        self.root_password_confirm: Gtk.PasswordEntry | None = None
        self.timezone_dropdown: Gtk.DropDown | None = None
        self.helper_dropdown: Gtk.DropDown | None = None
        self.nct_check: Gtk.CheckButton | None = None
        self.chaotic_check: Gtk.CheckButton | None = None
        self.review_label: Gtk.Label | None = None
        self.log_buffer: Gtk.TextBuffer | None = None
        self.progress_label: Gtk.Label | None = None
        self.spinner: Gtk.Spinner | None = None
        self.config_path: Path | None = None
        self.install_started = False
        self.install_finished = False

    def do_activate(self) -> None:
        """Create and present the application window."""
        if self.window is not None:
            self.window.present()
            return
        self._install_css()
        self._build_window()
        assert self.window is not None
        self.window.present()

