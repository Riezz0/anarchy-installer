        if not options:
            options = ["No writable drives detected"]
        self.disk_dropdown = Gtk.DropDown.new_from_strings(options)
        self.disk_dropdown.set_enable_search(True)
        self.disk_dropdown.set_hexpand(True)
        card = self._vbox(15)
        card.add_css_class("card")
        card.append(self._label("INSTALL TARGET", "card-title"))
        card.append(self._label("All data on the selected drive will be erased.", "muted"))
        card.append(self.disk_dropdown)
        page.append(card)
        warning = self._vbox(7)
        warning.add_css_class("warning-card")
        warning.append(self._label("⚠  This is a destructive operation", "warning-text"))
        warning.append(self._label("The selected disk will be repartitioned and formatted. You’ll review the exact target again before starting.", "warning-text"))
        page.append(warning)
        bundle_status = self._vbox(7)
        bundle_status.add_css_class("card")
        bundle_status.append(self._label("OFFLINE INSTALLATION BUNDLE", "card-title"))
        bundle_status.append(
            self._label(
                ("✓  Offline package repository is ready" if self.repository_ready else "✕  Offline package repository is missing"),
