    @staticmethod
    def _label(text: str, css_class: str | None = None) -> Gtk.Label:
        label = Gtk.Label(label=text)
        label.set_xalign(0)
        label.set_wrap(True)
        if css_class:
            label.add_css_class(css_class)
        return label

    @staticmethod
    def _vbox(spacing: int = 12) -> Gtk.Box:
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=spacing)
        return box

    @staticmethod
    def _card(title: str, subtitle: str, child: Gtk.Widget) -> Gtk.Box:
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        card.add_css_class("card")
        card.append(OfflineInstaller._label(title, "card-title"))
        if subtitle:
            card.append(OfflineInstaller._label(subtitle, "muted"))
        card.append(child)
        return card

    @staticmethod
    def _field(label: str, widget: Gtk.Widget) -> Gtk.Box:
        row = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=7)
        row.append(OfflineInstaller._label(label, "field-label"))
        row.append(widget)
        return row

    def _build_window(self) -> None:
        self.window = Gtk.ApplicationWindow(application=self, title="Anarchy Offline Installer")
        self.window.set_default_size(1020, 740)
        self.window.set_size_request(780, 620)
        self.window.connect("close-request", self._on_close_request)

        shell = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        shell.add_css_class("app-shell")
        shell.append(self._build_header())

        body = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        body.append(self._build_sidebar())
        content = self._vbox(0)
        content.set_hexpand(True)
        content.set_vexpand(True)
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.stack.set_transition_duration(180)
        self.stack.set_hexpand(True)
        self.stack.set_vexpand(True)
        for name, page in (
            ("welcome", self._build_welcome_page()),
            ("account", self._build_account_page()),
            ("options", self._build_options_page()),
            ("review", self._build_review_page()),
            ("progress", self._build_progress_page()),
        ):
            self.stack.add_named(page, name)
        content.append(self.stack)
        body.append(content)
        shell.append(body)
        shell.append(self._build_footer())
        self.window.set_child(shell)
        self._show_page(0)

