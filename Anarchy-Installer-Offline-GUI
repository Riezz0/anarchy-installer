            window { background-color: #161821; color: #c0caf5; }
            .app-shell { background-color: #161821; }
            .topbar { background-color: #1a1d27; border-bottom: 1px solid #30364a; padding: 18px 26px; }
            .brand-mark { background: #292e42; border-radius: 14px; color: #bb9af7; padding: 11px; font-size: 20px; font-weight: 800; }
            .brand-title { color: #c0caf5; font-size: 19px; font-weight: 750; }
            .brand-subtitle, .muted { color: #7982a9; }
            .content { padding: 28px; }
            .hero { color: #c0caf5; font-size: 27px; font-weight: 800; }
            .description { color: #9aa4c7; font-size: 14px; }
