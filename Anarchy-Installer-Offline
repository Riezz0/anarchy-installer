#!/usr/bin/env bash
# ==============================================================================
# INTEGRATED STRICTLY OFFLINE ARCH LINUX INSTALLER (UEFI ONLY)
# ==============================================================================
set -Eeuo pipefail

if (( EUID != 0 )); then
    echo "❌ Error: Run this installer as root." >&2
    exit 1
fi

for command in gum lsblk grep sgdisk mkfs.vfat mkfs.btrfs btrfs modprobe mount umount mountpoint pacstrap genfstab arch-chroot blkid timedatectl; do
    if ! command -v "$command" >/dev/null 2>&1; then
        echo "❌ Error: Required command '$command' is missing from the live environment." >&2
        exit 1
    fi
done

LOCAL_REPO_DIR="/opt/arch-offline-repo"
DOTFILES_SOURCE_DIR="/opt/dotfiles"
PACMAN_CONF_FILE=''
CHROOT_SCRIPT=''
CHROOT_VALUES=''
GUI_CONFIG_FILE=${ANARCHY_INSTALLER_CONFIG:-}
GUI_MODE=false
[[ -n "$GUI_CONFIG_FILE" ]] && GUI_MODE=true

BG='#1a1b26'; FG='#c0caf5'; BLUE='#7aa2f7'; GREEN='#9ece6a'
YELLOW='#e0af68'; RED='#f7768e'; PURPLE='#bb9af7'
banner() {
    if $GUI_MODE; then printf '\n=== %s ===\n' "$1";
    else gum style --foreground "$PURPLE" --border double --border-foreground "$BLUE" --padding '0 2' --bold "$1"; fi
}
step() {
    if $GUI_MODE; then printf 'ANARCHY_STEP:%s\n' "$*";
    else gum style --foreground "$BLUE" --bold "➜ $*"; fi
}
ok() {
    if $GUI_MODE; then printf '✓ %s\n' "$*";
    else gum style --foreground "$GREEN" "✓ $*"; fi
}
fail() {
    if $GUI_MODE; then printf '✖ %s\n' "$*" >&2;
    else gum style --foreground "$RED" --bold "✖ $*" >&2; fi
}
warn() {
    if $GUI_MODE; then printf '⚠ %s\n' "$*";
    else gum style --foreground "$YELLOW" "$*"; fi
}
run_progress() {
    local title=$1
    shift
    step "$title"
    if $GUI_MODE; then "$@";
    else gum spin --spinner dot --show-error --title "$title" -- "$@"; fi
}

unmount_target() {
    cd /
    sync
    if mountpoint -q /mnt/opt/dotfiles; then
        umount /mnt/opt/dotfiles || return 1
    fi
    if mountpoint -q /mnt; then
        # Drop the now-unbound empty directory from the target filesystem.
        rmdir /mnt/opt/dotfiles 2>/dev/null || true
        if command -v fuser >/dev/null 2>&1; then
            local mount_pids pid process_name
            mount_pids=$(fuser -m /mnt 2>/dev/null || true)
            for pid in $mount_pids; do
                [[ "$pid" =~ ^[0-9]+$ && -r "/proc/$pid/comm" ]] || continue
                IFS= read -r process_name < "/proc/$pid/comm" || continue
                if [[ "$process_name" == gpg-agent ]]; then
                    kill -TERM "$pid" 2>/dev/null || true
                fi
            done
            sleep 1
        fi
        if ! umount -R /mnt; then
            findmnt -R /mnt >&2 || true
            if command -v fuser >/dev/null 2>&1; then fuser -vm /mnt >&2 || true; fi
            return 1
        fi
    fi
}

cleanup() {
    local status=$?
    trap - EXIT INT TERM
    set +e
    if mountpoint -q /mnt; then
        [[ -n "$CHROOT_SCRIPT" ]] && rm -f "$CHROOT_SCRIPT"
        [[ -n "$CHROOT_VALUES" ]] && rm -f "$CHROOT_VALUES"
        unmount_target || true
    fi
    [[ -n "$PACMAN_CONF_FILE" ]] && rm -f "$PACMAN_CONF_FILE"
    if [[ "$GUI_CONFIG_FILE" == /tmp/anarchy-offline-* && -f "$GUI_CONFIG_FILE" && ! -L "$GUI_CONFIG_FILE" ]]; then
        local config_owner config_mode expected_owner
        config_owner=$(stat -c '%u' "$GUI_CONFIG_FILE" 2>/dev/null || true)
        config_mode=$(stat -c '%a' "$GUI_CONFIG_FILE" 2>/dev/null || true)
        expected_owner=${SUDO_UID:-$EUID}
        if [[ "$config_owner" == "$expected_owner" && "$config_mode" == 600 ]]; then
            rm -f "$GUI_CONFIG_FILE"
        fi
    fi
    exit "$status"
}

# Clear mounts left behind by an earlier failed run, the same way the online
# installer does, so retries always start from a clean slate.
if mountpoint -q /mnt; then
    warn 'Clearing leftover mounts from a previous run...'
    unmount_target || { fail 'Could not clear the leftover mounts at /mnt.'; exit 1; }
fi
trap cleanup EXIT
trap 'exit 130' INT TERM

if [ ! -d "$LOCAL_REPO_DIR" ] || [ ! -f "$LOCAL_REPO_DIR/offline_repo.db" ]; then
    fail "Built-in repository or database index not found at $LOCAL_REPO_DIR"
    exit 1
fi

if [[ ! -d "$DOTFILES_SOURCE_DIR" ]]; then
    fail "Dotfiles bundle not found at $DOTFILES_SOURCE_DIR; refusing to partition the disk."
    exit 1
fi
for required_path in \
    sys/grub/grub sys/grub/tokyo-night sys/sddm/anarchy-sddm \
    sys/sddm/sddm.conf sys/sddm/initial-setup sys/fonts \
    scripts bg coolercontrol/etc/coolercontrol/config.toml cursors cursors/.local/share/icons fastfetch gradience gtk3 gtk4 hypr-themes hyprland icons kitty \
    kvantum neovim omz pywal qt5 qt6 rofi themes wal xkb zsh; do
    if [[ ! -e "$DOTFILES_SOURCE_DIR/$required_path" ]]; then
        fail "Required dotfiles path is missing: $DOTFILES_SOURCE_DIR/$required_path"
        exit 1
    fi
done

HOSTNAME="arch-zen-hyprland"
KEYMAP="us"

if $GUI_MODE; then
    if [[ "$GUI_CONFIG_FILE" != /tmp/anarchy-offline-* || ! -f "$GUI_CONFIG_FILE" || -L "$GUI_CONFIG_FILE" ]]; then
        fail 'GUI settings file is missing or invalid.'
        exit 1
    fi
    CONFIG_MODE=$(stat -c '%a' "$GUI_CONFIG_FILE")
    CONFIG_OWNER=$(stat -c '%u' "$GUI_CONFIG_FILE")
    EXPECTED_OWNER=${SUDO_UID:-$EUID}
    if [[ "$CONFIG_MODE" != 600 || "$CONFIG_OWNER" != "$EXPECTED_OWNER" ]]; then
        fail 'GUI settings must be an owner-only temporary file.'
        exit 1
    fi
    mapfile -d '' -t GUI_SETTINGS < "$GUI_CONFIG_FILE"
    if (( ${#GUI_SETTINGS[@]} != 8 )); then
        fail 'GUI settings file is incomplete; expected 8 values.'
        exit 1
    fi
    DISK=${GUI_SETTINGS[0]}
    NEW_USER=${GUI_SETTINGS[1]}
    USER_PASS=${GUI_SETTINGS[2]}
    ROOT_PASS=${GUI_SETTINGS[3]}
    TIMEZONE=${GUI_SETTINGS[4]}
    AUR_HELPER=${GUI_SETTINGS[5]}
    INSTALL_NCT6687D=${GUI_SETTINGS[6]}
    INSTALL_CHAOTIC_AUR=${GUI_SETTINGS[7]}
    [[ -b "$DISK" ]] || { fail "Invalid block device: $DISK"; exit 1; }
    [[ "$(lsblk -dnro TYPE "$DISK")" == disk ]] || { fail 'Select a whole disk, not a partition.'; exit 1; }
    [[ "$NEW_USER" =~ ^[a-z_][a-z0-9_-]*$ ]] || { fail 'Invalid username.'; exit 1; }
    [[ -n "$USER_PASS" && -n "$ROOT_PASS" ]] || { fail 'Passwords cannot be empty.'; exit 1; }
    [[ "$TIMEZONE" =~ ^[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)*$ ]] || { fail 'Invalid timezone format.'; exit 1; }
    [[ -f "/usr/share/zoneinfo/$TIMEZONE" ]] || { fail "Invalid timezone: $TIMEZONE"; exit 1; }
    [[ "$INSTALL_NCT6687D" == true || "$INSTALL_NCT6687D" == false ]] || { fail 'Invalid NCT6687D option.'; exit 1; }
    [[ "$INSTALL_CHAOTIC_AUR" == true || "$INSTALL_CHAOTIC_AUR" == false ]] || { fail 'Invalid Chaotic-AUR option.'; exit 1; }
    case "$AUR_HELPER" in
        yay) AUR_HELPER_PACKAGE=yay ;;
        paru) AUR_HELPER_PACKAGE=paru ;;
        pikaur) AUR_HELPER_PACKAGE=pikaur-git ;;
        *) fail 'Invalid AUR helper selection.'; exit 1 ;;
    esac
    ok "GUI settings received for $DISK"
else
    # --- DYNAMIC DRIVE SELECTION ---
    banner 'Target Drive'
    DISK_SELECTION=$(lsblk -dno NAME,SIZE,MODEL | grep -v loop | gum choose \
        --header 'Select the drive to install onto' --cursor '➜ ' --height 12 || true)
    if [[ -z "$DISK_SELECTION" ]]; then
        warn 'Installation cancelled.'
        exit 0
    fi
    DISK="/dev/${DISK_SELECTION%% *}"
    if [[ ! -b "$DISK" ]]; then fail "Invalid block device: $DISK"; exit 1; fi
    ok "Target drive: $DISK"

    banner 'User Account'
    while true; do
        NEW_USER=$(gum input --prompt 'Username: ' --placeholder 'e.g. dev')
        [[ "$NEW_USER" =~ ^[a-z_][a-z0-9_-]*$ ]] && break
        fail 'Invalid username. Use lowercase letters, numbers, - and _.'
    done
    while true; do
        USER_PASS=$(gum input --password --prompt "Password for $NEW_USER: ")
        USER_PASS_CONFIRM=$(gum input --password --prompt 'Confirm password: ')
        [[ -n "$USER_PASS" && "$USER_PASS" == "$USER_PASS_CONFIRM" ]] && break
        fail 'Passwords do not match or are empty. Please try again.'
    done
    while true; do
        ROOT_PASS=$(gum input --password --prompt 'Root password: ')
        ROOT_PASS_CONFIRM=$(gum input --password --prompt 'Confirm root password: ')
        [[ -n "$ROOT_PASS" && "$ROOT_PASS" == "$ROOT_PASS_CONFIRM" ]] && break
        fail 'Passwords do not match or are empty. Please try again.'
    done

    banner 'Timezone'
    TIMEZONE=$(timedatectl list-timezones | gum filter \
        --placeholder 'Search timezone, e.g. Europe/London' || true)
    TIMEZONE=${TIMEZONE:-UTC}
    ok "Timezone: $TIMEZONE"

    banner 'AUR Helper'
    AUR_HELPER=$(gum choose --header 'Select one AUR helper to install' \
        --cursor '➜ ' yay paru pikaur || true)
    [[ -n "$AUR_HELPER" ]] || { warn 'Installation cancelled.'; exit 0; }
    case "$AUR_HELPER" in
        yay) AUR_HELPER_PACKAGE=yay ;;
        paru) AUR_HELPER_PACKAGE=paru ;;
        pikaur) AUR_HELPER_PACKAGE=pikaur-git ;;
    esac

    INSTALL_NCT6687D=false
    if [[ -d "$DOTFILES_SOURCE_DIR/nct6687d" ]]; then
        INSTALL_NCT6687D=true
    elif gum confirm --affirmative 'Install' --negative 'Skip' \
        'Install the NCT6687D DKMS driver? (requires Internet)'; then
        INSTALL_NCT6687D=true
    fi
    INSTALL_CHAOTIC_AUR=false
    if gum confirm --affirmative 'Enable' --negative 'Skip' \
        'Enable the Chaotic-AUR repository? (requires Internet)'; then
        INSTALL_CHAOTIC_AUR=true
    fi
    NCT_LABEL=No
    [[ "$INSTALL_NCT6687D" == true ]] && NCT_LABEL=Yes
    CHAOTIC_LABEL=No
    [[ "$INSTALL_CHAOTIC_AUR" == true ]] && CHAOTIC_LABEL=Yes
    banner 'Summary'
    SUMMARY=$(printf 'User:       %s\nHostname:   %s\nDrive:      %s\nTimezone:   %s\nAUR helper: %s\nNCT6687D:   %s\nChaotic-AUR: %s' \
        "$NEW_USER" "$HOSTNAME" "$DISK" "$TIMEZONE" "$AUR_HELPER" \
        "$NCT_LABEL" "$CHAOTIC_LABEL")
    gum style --foreground "$FG" --border rounded --padding '1 2' "$SUMMARY"
    if ! gum confirm --default=false --affirmative 'Wipe and install' --negative 'Cancel' \
        "This will completely wipe $DISK. Proceed?"; then
        warn 'Installation aborted by user.'
        exit 0
    fi
fi

NCT_BUILD_PACKAGES=()
if [[ "$INSTALL_NCT6687D" == true ]]; then NCT_BUILD_PACKAGES=(dkms base-devel); fi

if [[ "$DISK" == *"nvme"* ]] || [[ "$DISK" == *"mmcblk"* ]]; then
    EFI_PART="${DISK}p1"; ROOT_PART="${DISK}p2"
else
    EFI_PART="${DISK}1"; ROOT_PART="${DISK}2"
fi

# --- DISK PARTITIONING & FORMATTING ---
step "Partitioning $DISK"
sgdisk --clear "$DISK"
sgdisk --new=1:0:+512M --typecode=1:ef00 --change-name=1:"EFI" "$DISK"
sgdisk --new=2:0:0      --typecode=2:8300 --change-name=2:"ROOT" "$DISK"
sleep 2
ok 'Partition table written'

step 'Formatting filesystems'
mkfs.vfat -F 32 "$EFI_PART"
mkfs.btrfs -f -O '^block-group-tree' "$ROOT_PART"
ok 'Filesystems formatted'

step 'Creating Btrfs subvolumes'
modprobe btrfs
mount "$ROOT_PART" /mnt
for subvolume in @ @home @log @pkg @.snapshots; do
    btrfs subvolume create "/mnt/$subvolume"
done
umount /mnt
ok 'Subvolumes created'

step 'Mounting target subvolumes'
mount -o noatime,compress=zstd,subvol=@ "$ROOT_PART" /mnt
mkdir -p /mnt/{home,var/log,var/cache/pacman/pkg,.snapshots,boot/efi}
mount -o noatime,compress=zstd,subvol=@home "$ROOT_PART" /mnt/home
mount -o noatime,compress=zstd,subvol=@log "$ROOT_PART" /mnt/var/log
mount -o noatime,compress=zstd,subvol=@pkg "$ROOT_PART" /mnt/var/cache/pacman/pkg
mount -o noatime,compress=zstd,subvol=@.snapshots "$ROOT_PART" /mnt/.snapshots
mount "$EFI_PART" /mnt/boot/efi
ok 'Target filesystems mounted'

# --- CONFIGURE PACMAN FOR ISOLATION ---
step 'Configuring strict offline repository isolation'
PACMAN_CONF_FILE="$(mktemp /tmp/pacman-offline.XXXXXX.conf)"
cat <<EOF > "$PACMAN_CONF_FILE"
[options]
Architecture = auto
SigLevel = Optional TrustAll
LocalFileSigLevel = Optional

[offline_repo]
SigLevel = Optional TrustAll
Server = file://$LOCAL_REPO_DIR
EOF
ok 'Offline repository configuration written'

# --- PACSTRAP SEQUENCE ---
if ! run_progress 'Installing packages from the offline repository' \
    pacstrap -C "$PACMAN_CONF_FILE" -K /mnt \
    base linux-zen linux-zen-headers linux-firmware linux-firmware-amdgpu btrfs-progs grub efibootmgr networkmanager nano sudo git \
    "${NCT_BUILD_PACKAGES[@]}" \
    sddm uwsm hyprland kitty rofi mesa pipewire pipewire-audio wireplumber stow zsh \
    vulkan-radeon lib32-mesa lib32-vulkan-radeon \
    terminus-font gptfdisk e2fsprogs dosfstools adw-gtk-theme otf-font-awesome wlsunset \
    awww blueman bluez bluez-utils coolercontrol coolercontrold eza fastfetch hypridle hyprlock \
    hyprpicker hyprsunset mesa-utils nautilus neovim npm nwg-look python-gobject \
    qt5-graphicaleffects qt5-imageformats qt5-multimedia qt5-quickcontrols2 qt5-quickcontrols qt5-svg \
    qt6-5compat qt6-base qt6-declarative qt6-imageformats qt6-multimedia qt6-svg \
    ttf-jetbrains-mono-nerd vlc vlc-plugins-all xdg-terminal-exec yt-dlp zsh-autocomplete \
    zsh-autosuggestions zsh-syntax-highlighting wl-clipboard arch-update goverlay-git \
    gradience-git grim-git gtk2 hyprmon-bin hyprscratch kvantum-qt6-git nautilus-admin-gtk4 \
    nautilus-open-any-terminal-git oh-my-zsh-git python-anyascii python-cssutils python-encutils \
    python-libsass python-material-color-utilities python-pywal16 python-pywalfox python-yapsy-git \
    qt5-styleplugins slurp-git vesktop-bin ttf-font-awesome-4 ttf-font-awesome-5 vkbasalt \
    wf-recorder-git xfce-polkit zsh-autoswitch-virtualenv-git zsh-fast-syntax-highlighting \
    arch-install-scripts xorg-xwayland firefox foot polkit-gnome vulkan-radeon lib32-mesa \
    xdg-desktop-portal xdg-desktop-portal-hyprland gum make lib32-vulkan-radeon figlet qt5ct qt6ct \
    chromium liquidctl libqalculate cava aubio brightnessctl power-profiles-daemon fish \
    gcc ddcutil swappy qt6-imageformats lm_sensors pipewire wl-clipboard quickshell \
    "$AUR_HELPER_PACKAGE"; then
    fail 'Offline package installation failed. See the output above.'
    exit 1
fi
ok 'Base system and desktop packages installed'

step 'Generating fstab'
genfstab -U /mnt >> /mnt/etc/fstab
ok 'fstab written'
ROOT_UUID=$(blkid -s UUID -o value "$ROOT_PART")
mkdir -p /mnt/opt/dotfiles
mount --bind "$DOTFILES_SOURCE_DIR" /mnt/opt/dotfiles

# --- INTERNAL SYSTEM PROVISIONING (CHROOT) ---
step 'Configuring the installed system in a chroot'
if ! mountpoint -q /mnt || [[ ! -x /mnt/bin/bash || ! -d /mnt/etc ]]; then
    fail '/mnt is not a mounted, bootstrapped target system; refusing to configure it.'
    exit 1
fi

# Keep secrets in a root-only file and run a standalone script inside the
# chroot so nested quotes and heredocs are parsed by the target Bash.
CHROOT_SCRIPT=/mnt/root/anarchy-offline-setup.sh
CHROOT_VALUES=/mnt/root/.anarchy-offline-setup-values
# The EXIT trap installed above deletes both files before unmounting.
printf '%s\n' "$KEYMAP" "$TIMEZONE" "$HOSTNAME" "$NEW_USER" "$USER_PASS" \
    "$ROOT_PASS" "$ROOT_UUID" "$INSTALL_CHAOTIC_AUR" "$INSTALL_NCT6687D" > "$CHROOT_VALUES"
chmod 600 "$CHROOT_VALUES"
cat > "$CHROOT_SCRIPT" <<'CHROOT_SCRIPT_EOF'
#!/usr/bin/env bash
set -Eeuo pipefail

make_scripts_executable() {
    local root="$1" file prefix
    while IFS= read -r -d '' file; do
        case "$file" in
            *.sh|*.bash|*.zsh|*.py|*.pl|*.rb|*.lua|*.fish)
                chmod a+x "$file"
                ;;
            *)
                prefix=''
                IFS= read -r -N 2 prefix < "$file" 2>/dev/null || true
                if [[ "$prefix" == '#!' ]]; then
                    chmod a+x "$file"
                fi
                ;;
        esac
    done < <(find "$root" -type f -print0)
}

mapfile -t install_values < /root/.anarchy-offline-setup-values
(( ${#install_values[@]} == 9 )) || { echo 'Invalid installer configuration values.' >&2; exit 1; }
KEYMAP=${install_values[0]}
TIMEZONE=${install_values[1]}
HOSTNAME=${install_values[2]}
NEW_USER=${install_values[3]}
USER_PASS=${install_values[4]}
ROOT_PASS=${install_values[5]}
ROOT_UUID=${install_values[6]}
INSTALL_CHAOTIC_AUR=${install_values[7]}
INSTALL_NCT6687D=${install_values[8]}
DOTFILES_DIR="/home/$NEW_USER/anarchydots"

        # Setup localization and clocks
        echo "LANG=en_US.UTF-8" > /etc/locale.gen
        echo "KEYMAP=$KEYMAP" > /etc/vconsole.conf
        ln -sf "/usr/share/zoneinfo/$TIMEZONE" /etc/localtime
        hwclock --systohc

        # Loopback system network definitions
        echo "$HOSTNAME" > /etc/hostname
        printf "127.0.0.1   localhost\n::1         localhost\n127.0.1.1   %s.localdomain %s\n" \
            "$HOSTNAME" "$HOSTNAME" > /etc/hosts

        # Activate background system utilities
        systemctl enable NetworkManager
        systemctl enable sddm
        systemctl enable coolercontrold.service

        # Create standard user
        useradd -m -U -G wheel -s /bin/bash "$NEW_USER"

        # Assign passwords
        printf "root:%s\n%s:%s\n" "$ROOT_PASS" "$NEW_USER" "$USER_PASS" | chpasswd

        # Grant wheel permission configurations
        echo "%wheel ALL=(ALL:ALL) NOPASSWD: ALL" > /etc/sudoers.d/10-installer-wheel
        chmod 0440 /etc/sudoers.d/10-installer-wheel

        # Copy the locally bundled dotfiles and stow the desktop configuration.
        mkdir -p "$DOTFILES_DIR"
        cp -a /opt/dotfiles/. "$DOTFILES_DIR/"
        chown -R "$NEW_USER:$NEW_USER" "$DOTFILES_DIR"
        rm -rf "$DOTFILES_DIR/nct6687d" "$DOTFILES_DIR/.config" "$DOTFILES_DIR/.local" \
            "$DOTFILES_DIR/.cache" "$DOTFILES_DIR/.oh-my-zsh"
        make_scripts_executable "$DOTFILES_DIR"
        mkdir -p /usr/local/bin
        stow --restow --dir="$DOTFILES_DIR" --target=/usr/local scripts
        stow --restow --dir="$DOTFILES_DIR" --target=/ coolercontrol
        runuser -u "$NEW_USER" -- stow --restow --dir="$DOTFILES_DIR" \
            --target="/home/$NEW_USER" \
            bg cursors face fastfetch gradience gtk3 gtk4 hypr-themes hyprland icons kitty \
            kvantum neovim omz pywal qt5 qt6 quickshell rofi themes wal xkb zsh

        find -L /usr/local/bin -maxdepth 1 -type f -exec chmod a+x {} +
        install -d -o "$NEW_USER" -g "$NEW_USER" "/home/$NEW_USER/.local/share/themes"
        install -o "$NEW_USER" -g "$NEW_USER" -m 0755 \
            "/home/$NEW_USER/.config/.hypr-themes/tokyo-night/tokyo-night.sh" \
            "/home/$NEW_USER/.local/share/themes/hypr-theme-active.sh"
        install -d -o "$NEW_USER" -g "$NEW_USER" "/home/$NEW_USER/.local/share/fonts"
        cp -a "$DOTFILES_DIR/sys/fonts/." "/home/$NEW_USER/.local/share/fonts/"
        chsh -s /bin/zsh "$NEW_USER"

        # Apply the Nautilus terminal integration preferences for the new user.
        if command -v gsettings >/dev/null 2>&1 && \
           command -v dbus-run-session >/dev/null 2>&1 && \
           gsettings list-schemas | grep -qx com.github.stunkymonkey.nautilus-open-any-terminal; then
            runuser -u "$NEW_USER" -- env HOME="/home/$NEW_USER" dbus-run-session -- \
                gsettings set com.github.stunkymonkey.nautilus-open-any-terminal terminal kitty
            runuser -u "$NEW_USER" -- env HOME="/home/$NEW_USER" dbus-run-session -- \
                gsettings set com.github.stunkymonkey.nautilus-open-any-terminal keybindings '<Ctrl><Alt>t'
            runuser -u "$NEW_USER" -- env HOME="/home/$NEW_USER" dbus-run-session -- \
                gsettings set com.github.stunkymonkey.nautilus-open-any-terminal new-tab true
            runuser -u "$NEW_USER" -- env HOME="/home/$NEW_USER" dbus-run-session -- \
                gsettings set com.github.stunkymonkey.nautilus-open-any-terminal flatpak system
            runuser -u "$NEW_USER" -- env HOME="/home/$NEW_USER" nautilus -q >/dev/null 2>&1 || true
        fi

        # Install every bundled cursor theme system-wide for SDDM and other
        # users: cp -r ~/anarchydots/cursors/.local/share/icons/* /usr/share/icons/
        cp -r "$DOTFILES_DIR/cursors/.local/share/icons/." /usr/share/icons/

        # Let the user's cursor-theme helper update the system default theme.
        mkdir -p /usr/share/icons/default
        chown -R "$NEW_USER:$NEW_USER" /usr/share/icons/default
        chmod -R u+rwX,g+rwX,o+rX /usr/share/icons/default

        # Make all Stow-managed system scripts executable.
        shopt -s nullglob
        for script in /usr/local/bin/*; do
            [[ -f "$script" ]] && chmod a+x "$script"
        done

        # Install SDDM theme and wallpaper assets from the cloned dotfiles.
        mkdir -p /usr/share/sddm/themes
        cp -r "$DOTFILES_DIR/sys/sddm/anarchy-sddm" /usr/share/sddm/themes/
        cp "$DOTFILES_DIR/sys/sddm/sddm.conf" /etc/sddm.conf
        sed -i 's/^Session=hyprland-uswm$/Session=hyprland-uwsm.desktop/' /etc/sddm.conf
        # Same permissions as the SDDM wallpaper assets in /var/local: owned by
        # the new user in the sddm group and writable by them.
        chown "$NEW_USER:sddm" /etc/sddm.conf
        chmod u+rwX,g+rwX,o+rX /etc/sddm.conf
        mkdir -p /var/local/sddm-wallpaper
        cp -r "$DOTFILES_DIR/sys/sddm/initial-setup/." /var/local/sddm-wallpaper/
        chown -R "$NEW_USER:sddm" /var/local/sddm-wallpaper
        chmod -R u+rwX,g+rwX,o+rX /var/local/sddm-wallpaper

        # Initialize Arch keys before any optional online package operations.
        pacman-key --init
        pacman-key --populate archlinux

        # Ensure the installed system has the official core, extra, and multilib repos.
        awk '
            /^\[/ { skip = ($0 == "[core]" || $0 == "[extra]" || $0 == "[multilib]" || $0 == "[offline_repo]") }
            !skip { print }
        ' /etc/pacman.conf > /etc/pacman.conf.anarchy
        cat >> /etc/pacman.conf.anarchy <<'PACMAN_REPOSITORIES'

[core]
Include = /etc/pacman.d/mirrorlist

[extra]
Include = /etc/pacman.d/mirrorlist

[multilib]
Include = /etc/pacman.d/mirrorlist
PACMAN_REPOSITORIES
        mv /etc/pacman.conf.anarchy /etc/pacman.conf

        # Optionally enable Chaotic-AUR using its signed keyring and mirrorlist.
        if [[ "$INSTALL_CHAOTIC_AUR" == true ]]; then
            pacman-key --recv-key 3056513887B78AEB --keyserver keyserver.ubuntu.com
            pacman-key --lsign-key 3056513887B78AEB
            pacman -U --noconfirm \
                https://cdn-mirror.chaotic.cx/chaotic-aur/chaotic-keyring.pkg.tar.zst \
                https://cdn-mirror.chaotic.cx/chaotic-aur/chaotic-mirrorlist.pkg.tar.zst
            if ! grep -q '^\[chaotic-aur\]' /etc/pacman.conf; then
                printf '\n[chaotic-aur]\nInclude = /etc/pacman.d/chaotic-mirrorlist\n' >> /etc/pacman.conf
            fi
        fi

# Installing Chaotic-AUR requires current online package metadata.
if [[ "$INSTALL_CHAOTIC_AUR" == true ]]; then
    pacman -Syu --noconfirm
fi

if [[ "$INSTALL_NCT6687D" == true ]]; then
    echo "Installing the NCT6687D DKMS driver for the installed linux-zen kernel..."
    NCT_DRIVER_DIR="/home/$NEW_USER/tmp/nct6687d"
    install -d -o "$NEW_USER" -g "$NEW_USER" "/home/$NEW_USER/tmp"
    # Clone as root: a user-owned clone into a root-owned directory fails
    # with "Permission denied" while writing .git. Ownership is fixed below.
    rm -rf "$NCT_DRIVER_DIR"
    mkdir -p "$NCT_DRIVER_DIR"
    if [[ -d /opt/dotfiles/nct6687d ]]; then
        cp -a /opt/dotfiles/nct6687d/. "$NCT_DRIVER_DIR/"
    else
        git clone --depth 1 \
            https://github.com/Fred78290/nct6687d "$NCT_DRIVER_DIR"
    fi

    # Register the sources with DKMS in the canonical /usr/src location, then
    # build for every kernel installed in the target system (not the live
    # ISO kernel that is running inside this chroot).
    rm -rf /usr/src/nct6687d-1
    mkdir -p /usr/src/nct6687d-1
    cp "$NCT_DRIVER_DIR/dkms.conf" "$NCT_DRIVER_DIR/Kbuild" \
        "$NCT_DRIVER_DIR/Makefile" "$NCT_DRIVER_DIR/nct6687.c" /usr/src/nct6687d-1/
    if dkms status nct6687d/1 2>/dev/null | grep -q '^nct6687d/1'; then
        dkms remove nct6687d/1 --all
    fi
    dkms add -m nct6687d -v 1
    NCT_KERNEL_COUNT=0
    for kernel_dir in /usr/lib/modules/*; do
        [[ -e "$kernel_dir/build" ]] || continue
        dkms install -m nct6687d -v 1 -k "${kernel_dir##*/}"
        NCT_KERNEL_COUNT=$((NCT_KERNEL_COUNT + 1))
    done
    (( NCT_KERNEL_COUNT > 0 )) || { echo 'No target kernel headers found for NCT6687D DKMS.' >&2; exit 1; }
    install -D -m 0644 "$DOTFILES_DIR/sys/no_nct6683.conf" /etc/modprobe.d/no_nct6683.conf
    install -D -m 0644 "$DOTFILES_DIR/sys/nct6687.conf" /etc/modules-load.d/nct6687.conf
    chown -R "$NEW_USER:$NEW_USER" "$NCT_DRIVER_DIR"
    echo "NCT6687D is installed and configured to load on the next boot."
fi

# Build an initramfs with Btrfs support for the root filesystem.
        rm -rf /etc/mkinitcpio.conf.d
        cat > /etc/mkinitcpio.conf <<'MKINIT'
MODULES=(btrfs amdgpu)
BINARIES=()
FILES=()
HOOKS=(base udev autodetect modconf kms keyboard keymap consolefont block filesystems fsck)
MKINIT
        mkinitcpio -P

        # Install the GRUB theme and configure the Btrfs root subvolume.
        mkdir -p /usr/share/grub/themes
        cp "$DOTFILES_DIR/sys/grub/grub" /etc/default/grub
        cp -r "$DOTFILES_DIR/sys/grub/tokyo-night" /usr/share/grub/themes/
        sed -i "s|^GRUB_TOP_LEVEL=.*|GRUB_TOP_LEVEL='/boot/vmlinuz-linux-zen'|; s|^GRUB_CMDLINE_LINUX_DEFAULT=.*|GRUB_CMDLINE_LINUX_DEFAULT=\"root=UUID=$ROOT_UUID rootflags=subvol=@ rw\"|" /etc/default/grub

        # Compile the UEFI GRUB bootloader.
        grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=GRUB --removable
        grub-mkconfig -o /boot/grub/grub.cfg
CHROOT_SCRIPT_EOF
chmod 700 "$CHROOT_SCRIPT"
if ! run_progress 'Configuring the installed system' \
    arch-chroot /mnt /bin/bash /root/anarchy-offline-setup.sh; then
    fail 'System configuration failed. See the output above.'
    exit 1
fi
ok 'Installed system configured'
rm -f "$CHROOT_SCRIPT" "$CHROOT_VALUES"
CHROOT_SCRIPT=''; CHROOT_VALUES=''

# The installed system's pacman.conf lists core/extra/multilib, but an offline
# install never downloads their sync databases. Seed them from the databases
# bundled in the offline repository so first boot does not warn "database file
# for 'core' does not exist (use '-Sy' to download)".
step 'Seeding official package databases for first boot'
mkdir -p /mnt/var/lib/pacman/sync
missing_sync_dbs=0
seeded_sync_dbs=0
for sync_db in core extra multilib; do
    if [[ -f "/mnt/var/lib/pacman/sync/$sync_db.db" ]]; then
        continue
    fi
    missing_sync_dbs=$((missing_sync_dbs + 1))
    if [[ -f "$LOCAL_REPO_DIR/$sync_db.db" ]]; then
        cp -f "$LOCAL_REPO_DIR/$sync_db.db" /mnt/var/lib/pacman/sync/
        seeded_sync_dbs=$((seeded_sync_dbs + 1))
    fi
done
# The offline repository is stripped from the target's pacman.conf, so its
# database file is unused there.
rm -f /mnt/var/lib/pacman/sync/offline_repo.db
if (( missing_sync_dbs == 0 )); then
    ok 'Official sync databases already present'
elif (( seeded_sync_dbs == missing_sync_dbs )); then
    ok 'Seeded core, extra and multilib databases for first boot'
else
    warn "Only $seeded_sync_dbs of $missing_sync_dbs official sync databases were bundled; run 'pacman -Sy' after first boot."
fi

step 'Unmounting target filesystems'
if ! unmount_target; then
    fail 'Could not unmount /mnt. The installed system is configured, but a process or mount is still using it.'
    exit 1
fi
ok 'Target filesystems unmounted'

banner 'Installation Complete'
ok 'Strict offline system installation complete.'
printf '%s\n' \
    'Power down the device, remove the live USB, and reboot.' \
    'After boot, check CoolerControl with: systemctl status coolercontrold'
